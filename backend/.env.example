# Copy to backend/.env and adjust as needed. All values are optional —
# app/config.py ships the same defaults for the local Keycloak lab.

# --- Keycloak coordinates -------------------------------------------------
KEYCLOAK_BASE_URL=http://localhost:8080
KEYCLOAK_REALM=demo-realm

# Derived from the two above unless overridden:
# ISSUER=http://localhost:8080/realms/demo-realm
# JWKS_URL=http://localhost:8080/realms/demo-realm/protocol/openid-connect/certs
# INTROSPECTION_URL=http://localhost:8080/realms/demo-realm/protocol/openid-connect/token/introspect

# --- Expected token audience ----------------------------------------------
AUDIENCE=fastapi-api

# --- Confidential client used for introspection ---------------------------
CLIENT_ID=fastapi-api
CLIENT_SECRET=fastapi-api-secret

# --- CORS -----------------------------------------------------------------
ALLOWED_ORIGINS=http://localhost:3000

# --- Verification tuning --------------------------------------------------
JWKS_CACHE_TTL_SECONDS=300
JWT_LEEWAY_SECONDS=10
HTTP_TIMEOUT_SECONDS=5
